# =====================================================
# DESARROLLO LOCAL (docker-compose)
# =====================================================

# Database (local con Postgres del compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=calzado_user
DB_PASSWORD=calzado_pass
DB_NAME=calzado_db

# Redis (no usado actualmente, pero levantado por el compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# API
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# =====================================================
# PRODUCCIÓN EN RAILWAY (referencia, ver DEPLOY_RAILWAY.md)
# =====================================================
# NODE_ENV=production
# DATABASE_URL=postgres://...        # Inyectado por Railway: ${{ Postgres.DATABASE_URL }}
# DB_SSL=true                        # Railway Postgres requiere SSL
# DB_SYNC=true                       # Sólo el primer deploy, luego apagar
# JWT_SECRET=<openssl rand -base64 64>
# FRONTEND_URL=https://druts-frontend.up.railway.app
# NEXT_PUBLIC_API_URL=https://druts-backend.up.railway.app

# WhatsApp (Twilio o Meta API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AWS S3 (para imágenes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=calzado-images

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
